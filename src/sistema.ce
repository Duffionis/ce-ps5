// Intercetta le chiamate di sistema del programma ospite (con "syscall user dispatch" di Linux) e le serve noi.
// Il guest usa la convenzione FreeBSD (come PS4/PS5): numero in rax, argomenti in rdi, rsi, rdx, r10, r8, r9;
// in uscita rax = risultato e il flag CF segnala l'errore (rax = errno).
esterna funzione munmap(a: *byte, lunghezza: dimensione) -> intero;
esterna funzione prctl(opzione: intero, a: naturale64, b: naturale64, c: naturale64, d: naturale64) -> intero;
esterna funzione write(fd: intero, dati: *byte, n: dimensione) -> lungo;
esterna funzione read(fd: intero, dati: *byte, n: dimensione) -> lungo;
esterna funzione open(percorso: *byte, flag: intero, modo: intero) -> intero;
esterna funzione close(fd: intero) -> intero;
esterna funzione lseek(fd: intero, off: lungo, da: intero) -> lungo;
esterna funzione clock_gettime(id: intero, ts: *byte) -> intero;
esterna funzione nanosleep(richiesta: *byte, resto: *byte) -> intero;
esterna funzione __errno_location() -> *byte;
esterna funzione _exit(codice: intero);
esterna funzione sched_yield() -> intero;
esterna funzione pthread_create(t: *byte, attr: *byte, f: funzione(*byte) -> *byte, arg: *byte) -> intero;
esterna funzione syscall(n: lungo, a: lungo, b: lungo, c: lungo, d: lungo) -> lungo;

variabile prossimo_tid: naturale64 = 1001;
variabile prossimo_thunk: naturale64;
variabile ultima_syscall: naturale64;
variabile conteggio_syscall: naturale64;
variabile stub: naturale64;           // indirizzo della pagina col codice macchina: restorer, trampolino (cambia FS), cella guest_fs

// posizioni dei registri dentro l'ucontext_t di Linux x86-64
costante R_R8: dimensione = 40;
costante R_R9: dimensione = 48;
costante R_R10: dimensione = 56;
costante R_RDI: dimensione = 104;
costante R_RSI: dimensione = 112;
costante R_RDX: dimensione = 136;
costante R_RAX: dimensione = 144;
costante R_EFL: dimensione = 176;

funzione registro(ctx: *byte, o: dimensione) -> naturale64 {
    rischio { ritorna *((ctx + o) come *naturale64); }
}

funzione imposta_registro(ctx: *byte, o: dimensione, v: naturale64) {
    rischio { *((ctx + o) come *naturale64) = v; }
}

funzione ok(ctx: *byte, v: naturale64) {
    imposta_registro(ctx, R_RAX, v);
    imposta_registro(ctx, R_EFL, registro(ctx, R_EFL) & 18446744073709551614);   // CF = 0
}

funzione errore(ctx: *byte, codice: naturale64) {
    imposta_registro(ctx, R_RAX, codice);
    imposta_registro(ctx, R_EFL, registro(ctx, R_EFL) | 1);                      // CF = 1
}

funzione errno_host() -> naturale64 {
    rischio { ritorna (*(__errno_location() come *intero)) come naturale64; }
}

// il risultato di una funzione C che ritorna -1 in caso di errore
funzione esito(ctx: *byte, r: lungo) {
    se r < 0 { errore(ctx, errno_host()); } altrimenti { ok(ctx, r come naturale64); }
}

// ---- funzioni scritte in linguaggio macchina nella pagina dello stub ----
funzione chiama_stub0(scarto: dimensione) -> naturale64 {
    variabile f: funzione() -> naturale64;
    rischio { f = ((stub + (scarto come naturale64)) come *byte) come funzione() -> naturale64; }
    ritorna f();
}
funzione leggi_fs() -> naturale64 { ritorna chiama_stub0(16); }
funzione leggi_gs() -> naturale64 { ritorna chiama_stub0(32); }
funzione imposta_gs(v: naturale64) {
    variabile f: funzione(naturale64);
    rischio { f = ((stub + 48) come *byte) come funzione(naturale64); }
    f(v);
}

// Ogni thread ha un blocco di controllo, il cui indirizzo sta nel registro GS (il guest non lo usa):
//   +0 FS dell'ospite (libc)   +8 FS del guest (TLS)   +16 selettore (1 = guest sotto sorveglianza)   +24 numero del thread
funzione blocco() -> *byte {
    rischio { ritorna leggi_gs() come *byte; }
}

funzione leggi_blocco64(o: dimensione) -> naturale64 {
    rischio { ritorna *((blocco() + o) come *naturale64); }
}

funzione scrivi_blocco64(o: dimensione, v: naturale64) {
    rischio { *((blocco() + o) come *naturale64) = v; }
}

funzione selettore(v: byte) {
    rischio { *(blocco() + 16) = v; }
}

funzione converti_open(f: naturale64) -> intero {
    // FreeBSD -> Linux: O_CREAT 0x200 -> 0x40, O_TRUNC 0x400 -> 0x200, O_APPEND 8 -> 0x400, O_EXCL 0x800 -> 0x80
    variabile l: intero = (f & 3) come intero;
    se (f & 512) != 0 { l = l | 64; }
    se (f & 1024) != 0 { l = l | 512; }
    se (f & 8) != 0 { l = l | 1024; }
    se (f & 2048) != 0 { l = l | 128; }
    ritorna l;
}

// i servizi (numeri FreeBSD)
funzione servi(ctx: *byte) {
    costante n: naturale64 = registro(ctx, R_RAX);
    costante a1: naturale64 = registro(ctx, R_RDI);
    costante a2: naturale64 = registro(ctx, R_RSI);
    costante a3: naturale64 = registro(ctx, R_RDX);
    costante a4: naturale64 = registro(ctx, R_R10);
    costante a5: naturale64 = registro(ctx, R_R8);
    costante a6: naturale64 = registro(ctx, R_R9);
    ultima_syscall = n;
    conteggio_syscall += 1;
    rischio {
        scegli n {
            caso 1 { _exit(a1 come intero); }
            caso 3 { esito(ctx, read(a1 come intero, a2 come *byte, a3 come dimensione)); }
            caso 4 { esito(ctx, write(a1 come intero, a2 come *byte, a3 come dimensione)); }
            caso 5 { esito(ctx, open(a1 come *byte, converti_open(a2), a3 come intero) come lungo); }
            caso 6 { esito(ctx, close(a1 come intero) come lungo); }
            caso 20 { ok(ctx, 1000); }
            caso 331 { sched_yield(); ok(ctx, 0); }
            caso 340 { ok(ctx, 0); }   // sigprocmask: ignorata
            caso 431 { esci_thread(a1); }
            caso 432 { *(a1 come *naturale64) = leggi_blocco64(24); ok(ctx, 0); }
            caso 454 { umtx(ctx, a1, a2, a3, a4); }
            caso 455 { crea_thread(ctx, a1); }
            caso 73 { esito(ctx, munmap(a1 come *byte, a2 come dimensione) come lungo); }
            caso 74 { esito(ctx, mprotect(a1 come *byte, a2 come dimensione, a3 come intero) come lungo); }
            caso 165 {   // sysarch(op, arg): 129 = imposta la base di FS (il TLS del guest), 130 = la legge
                se a1 == 129 {
                    scrivi_blocco64(8, *(a2 come *naturale64));
                    ok(ctx, 0);
                } altrimenti se a1 == 130 {
                    *(a2 come *naturale64) = leggi_blocco64(8);
                    ok(ctx, 0);
                } altrimenti { errore(ctx, 22); }
            }
            caso 232 {   // clock_gettime: CLOCK_MONOTONIC di FreeBSD e' 4, su Linux 1
                variabile id: intero = 0;
                se a1 == 4 { id = 1; }
                esito(ctx, clock_gettime(id, a2 come *byte) come lungo);
            }
            caso 240 { esito(ctx, nanosleep(a1 come *byte, a2 come *byte) come lungo); }
            caso 477 {   // mmap: MAP_ANON di FreeBSD (0x1000) -> 0x20 di Linux
                variabile fl: intero = (a4 & 19) come intero;
                se (a4 & 4096) != 0 { fl = fl | 32; }
                costante p: *byte = mmap(a1 come *byte, a2 come dimensione, a3 come intero, fl, a5 come intero, a6 come lungo);
                se (p come naturale64) == 18446744073709551615 { errore(ctx, errno_host()); } altrimenti { ok(ctx, p come naturale64); }
            }
            caso 478 { esito(ctx, lseek(a1 come intero, a2 come lungo, a3 come intero)); }
            altrimenti { errore(ctx, 78); }   // ENOSYS
        }
    }
}

// ---- thread del guest ----
// Il guest chiede un thread (thr_new): ne creiamo uno vero, che parte con il TLS e lo stack scelti dal guest.
funzione avvio_thread(arg: *byte) -> *byte {
    costante info: *byte = arg;
    rischio { imposta_gs(arg come naturale64); }
    variabile avvia: funzione(naturale64, naturale64, naturale64, naturale64);
    rischio {
        costante inizio: naturale64 = *((info + 128) come *naturale64);
        costante a: naturale64 = *((info + 136) come *naturale64);
        costante cima: naturale64 = *((info + 144) come *naturale64);
        costante tls: naturale64 = *((info + 152) come *naturale64);
        costante tid_figlio: naturale64 = *((info + 160) come *naturale64);
        scrivi_blocco64(0, leggi_fs());
        scrivi_blocco64(8, tls);
        se tid_figlio != 0 { *(tid_figlio come *naturale64) = leggi_blocco64(24); }
        se prctl(59, 1, stub, 4096, (arg + 16) come naturale64) != 0 { ritorna arg; }
        *((info + 168) come *naturale64) = 1;            // pronto: il genitore puo' tornare al guest
        // il thread nasce dentro il gestore, dove SIGSYS e' bloccato: va sbloccato prima di far partire il guest
        variabile maschera: [naturale64; 1];
        maschera[0] = 1073741824;
        syscall(14, 1, ((&maschera[0]) come naturale64) come lungo, 0, 8);                       // rt_sigprocmask(SIG_UNBLOCK)
        avvia = ((stub + 144) come *byte) come funzione(naturale64, naturale64, naturale64, naturale64);
        selettore(1);
        avvia(inizio, a, cima, tls);
    }
    ritorna arg;
}

funzione crea_thread(ctx: *byte, p: naturale64) {
    variabile b: *byte;
    rischio {
        b = mmap((0 come dimensione) come *byte, 4096, 3, 34, -1, 0);
        costante par: *byte = p come *byte;
        costante pid_tid: naturale64 = prossimo_tid;
        prossimo_tid += 1;
        *((b + 24) come *naturale64) = pid_tid;
        *((b + 128) come *naturale64) = *(par come *naturale64);                           // start_func
        *((b + 136) come *naturale64) = *((par + 8) come *naturale64);                     // arg
        *((b + 144) come *naturale64) = *((par + 16) come *naturale64) + *((par + 24) come *naturale64);   // cima dello stack
        *((b + 152) come *naturale64) = *((par + 32) come *naturale64);                    // tls_base
        *((b + 160) come *naturale64) = *((par + 48) come *naturale64);                    // child_tid
        costante parent_tid: naturale64 = *((par + 56) come *naturale64);
        se parent_tid != 0 { *(parent_tid come *naturale64) = pid_tid; }
    }
    variabile id: [naturale64; 1];
    variabile r: intero = 0;
    rischio { r = pthread_create((&id[0]) come *byte, (0 come dimensione) come *byte, avvio_thread, b); }
    se r != 0 { errore(ctx, 11); ritorna; }
    // il nuovo thread eredita il selettore del genitore: finche' non ha il proprio, il genitore resta nel gestore
    rischio { mentre *((b + 168) come *naturale64) == 0 { sched_yield(); } }
    ok(ctx, 0);
}

funzione esci_thread(stato: naturale64) {
    rischio {
        se stato != 0 {
            *(stato come *naturale64) = 1;
            syscall(202, stato come lungo, 1, 2147483647, 0);    // FUTEX_WAKE
        }
        syscall(60, 0, 0, 0, 0);                                 // fine del solo thread
    }
}

// _umtx_op: l'attesa/risveglio di FreeBSD, tradotta in futex di Linux
funzione umtx(ctx: *byte, oggetto: naturale64, op: naturale64, valore: naturale64, tempo: naturale64) {
    scegli op {
        caso 2, 11, 15 {   // WAIT: dormi finche' *oggetto == valore
            rischio {
                se (*(oggetto come *naturale32)) == (valore come naturale32) {
                    syscall(202, oggetto come lungo, 0, valore come lungo, 0);       // FUTEX_WAIT (puo' tornare presto: il chiamante ripete)
                }
            }
            ok(ctx, 0);
        }
        caso 3, 16 {       // WAKE: sveglia 'valore' thread
            variabile n: lungo = 0;
            rischio { n = syscall(202, oggetto come lungo, 1, valore come lungo, 0); }
            ok(ctx, 0);
        }
        altrimenti { errore(ctx, 78); }
    }
}

funzione gestore(sig: intero, info: *byte, ctx: *byte) {
    selettore(0);      // dentro il gestore le syscall dell'ospite (libc) sono permesse
    servi(ctx);
    selettore(1);      // e il guest torna sotto sorveglianza
}

funzione scrivi64(p: *byte, o: dimensione, v: naturale64) {
    rischio { *((p + o) come *naturale64) = v; }
}

// installa il gestore SIGSYS e le "syscall user dispatch": da qui in poi, quando il selettore del thread e' 1,
// ogni 'syscall' eseguita fuori dalla pagina dello stub arriva a 'gestore'. Lo stub scambia FS (TLS del guest <-> dell'ospite).
funzione prepara() -> booleano {
    costante codice: [byte; 512] = [184, 15, 0, 0, 0, 15, 5, 204, 204, 204, 204, 204, 204, 204, 204, 204, 243, 72, 15, 174, 192, 195, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 243, 72, 15, 174, 200, 195, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 243, 72, 15, 174, 223, 195, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 83, 243, 72, 15, 174, 195, 101, 72, 139, 4, 37, 0, 0, 0, 0, 243, 72, 15, 174, 208, 101, 72, 137, 28, 37, 8, 0, 0, 0, 255, 21, 157, 0, 0, 0, 101, 72, 139, 4, 37, 8, 0, 0, 0, 243, 72, 15, 174, 208, 91, 195, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 243, 72, 15, 174, 209, 72, 137, 212, 72, 131, 228, 240, 72, 137, 248, 72, 137, 247, 49, 237, 255, 208, 49, 255, 184, 60, 0, 0, 0, 15, 5, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 0, 0, 0, 0, 0, 0, 0, 0, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 83, 65, 84, 65, 85, 243, 72, 15, 174, 195, 101, 76, 139, 36, 37, 0, 0, 0, 0, 243, 73, 15, 174, 212, 101, 198, 4, 37, 16, 0, 0, 0, 0, 255, 208, 101, 198, 4, 37, 16, 0, 0, 0, 1, 243, 72, 15, 174, 211, 65, 93, 65, 92, 91, 195, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204, 204];
    variabile pagina_stub: *byte;
    variabile tcb: *byte;
    rischio {
        pagina_stub = mmap((0 come dimensione) come *byte, 4096, 7, 34, -1, 0);
        per i in 0..512 { *(pagina_stub + i) = codice[i]; }
        stub = pagina_stub come naturale64;
        tcb = mmap((0 come dimensione) come *byte, 4096, 3, 34, -1, 0);
    }
    variabile g: funzione(intero, *byte, *byte) = gestore;
    rischio { scrivi64(pagina_stub, 256, (g come *byte) come naturale64); }          // handler_c
    rischio { imposta_gs(tcb come naturale64); }
    scrivi_blocco64(0, leggi_fs());
    scrivi_blocco64(8, leggi_fs());
    scrivi_blocco64(24, 1000);
    variabile ksa: [byte; 32];
    variabile errore_sa: lungo = 0;
    rischio {
        costante k: *byte = &ksa[0];
        scrivi64(k, 0, ((pagina_stub + 64) come naturale64));               // il gestore e' il trampolino
        scrivi64(k, 8, 4 | 67108864);                                        // SA_SIGINFO | SA_RESTORER
        scrivi64(k, 16, (pagina_stub come naturale64));                      // restorer
        scrivi64(k, 24, 0);
        errore_sa = syscall(13, 31, (k come naturale64) come lungo, 0, 8);   // rt_sigaction(SIGSYS)
        se errore_sa != 0 { ritorna falso; }
        se prctl(59, 1, pagina_stub come naturale64, 4096, (tcb + 16) come naturale64) != 0 { ritorna falso; }
    }
    ritorna vero;
}

// Un "ponte" per una funzione dell'ospite chiamabile dal guest (convenzione System V, argomenti interi):
// cambia FS e il selettore, chiama la funzione, rimette tutto a posto. Ritorna l'indirizzo del ponte.
funzione ponte(funzione_ospite: naturale64) -> naturale64 {
    costante dove: naturale64 = stub + 512 + prossimo_thunk * 16;
    prossimo_thunk += 1;
    // mov rax, imm64 ; jmp comune
    rischio {
        costante p: *byte = dove come *byte;
        *p = 0x48; *(p + 1) = 0xB8;
        *((p + 2) come *naturale64) = funzione_ospite;
        *(p + 10) = 0xE9;
        costante rel: naturale64 = (stub + 288) - (dove + 15);
        *((p + 11) come *naturale32) = (rel & 4294967295) come naturale32;
    }
    ritorna dove;
}
